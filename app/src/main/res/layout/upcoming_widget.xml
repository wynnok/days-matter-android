<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
  <TextView android:id="@+id/upcoming_title" android:layout_width="match_parent" android:layout_height="28dp"
    android:text="近期日程" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/upcoming_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textSize="14sp" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/upcoming_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textSize="14sp" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/upcoming_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textSize="14sp" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/upcoming_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textSize="14sp" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/upcoming_row_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textSize="14sp" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/upcoming_status" android:layout_width="match_parent" android:layout_height="32dp"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:textSize="10sp" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/upcoming_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingVertical="6dp" android:text="查看全部" android:textSize="12sp" android:textColor="@color/widget_foreground" />
    <TextView android:id="@+id/upcoming_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingVertical="6dp" android:text="新增" android:textSize="12sp" android:textColor="@color/widget_foreground" />
    <TextView android:id="@+id/upcoming_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingVertical="6dp" android:text="刷新" android:textSize="12sp" android:textColor="@color/widget_foreground" />
  </LinearLayout>
</LinearLayout>
