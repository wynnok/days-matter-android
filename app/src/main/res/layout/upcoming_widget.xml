<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
      <TextView android:id="@+id/upcoming_title" android:layout_width="match_parent" android:layout_height="20dp" android:text="近期日程" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
      <TextView android:id="@+id/upcoming_scope" android:layout_width="match_parent" android:layout_height="14dp" android:text="未来 30 天 · 全部分类" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/upcoming_all" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:text="全部 ›" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:contentDescription="查看全部日程" />
  </LinearLayout>
  <LinearLayout android:id="@+id/upcoming_item_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
      <TextView android:id="@+id/upcoming_row_1" android:layout_width="match_parent" android:layout_height="20dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
      <TextView android:id="@+id/upcoming_date_1" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="1dp" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/upcoming_days_1" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/upcoming_item_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
      <TextView android:id="@+id/upcoming_row_2" android:layout_width="match_parent" android:layout_height="20dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
      <TextView android:id="@+id/upcoming_date_2" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="1dp" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/upcoming_days_2" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/upcoming_item_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
      <TextView android:id="@+id/upcoming_row_3" android:layout_width="match_parent" android:layout_height="20dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
      <TextView android:id="@+id/upcoming_date_3" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="1dp" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/upcoming_days_3" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/upcoming_item_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
      <TextView android:id="@+id/upcoming_row_4" android:layout_width="match_parent" android:layout_height="20dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
      <TextView android:id="@+id/upcoming_date_4" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="1dp" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/upcoming_days_4" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/upcoming_item_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
      <TextView android:id="@+id/upcoming_row_5" android:layout_width="match_parent" android:layout_height="20dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" android:textColor="@color/widget_foreground" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
      <TextView android:id="@+id/upcoming_date_5" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="1dp" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/upcoming_days_5" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/upcoming_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
    <ImageView android:id="@+id/upcoming_empty_icon" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_calendar" android:importantForAccessibility="no" />
    <TextView android:id="@+id/upcoming_empty_title" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="6dp" android:text="近期暂无日程" android:gravity="center" android:textSize="13sp" android:includeFontPadding="false" android:textColor="@color/widget_foreground" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/upcoming_empty_hint" android:layout_width="match_parent" android:layout_height="16dp" android:text="让每个值得期待的日子，都在这里" android:gravity="center" android:textSize="10sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/upcoming_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="9sp" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/upcoming_add" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:text="新增" android:textSize="10sp" android:textColor="@color/widget_accent" />
    <TextView android:id="@+id/upcoming_refresh" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:text="刷新" android:textSize="10sp" android:textColor="@color/widget_accent" />
  </LinearLayout>
